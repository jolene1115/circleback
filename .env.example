# Copy this file to .env and paste your key (get one free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# Model used for speech-to-text. Free-tier quotas are per model; flash-lite is fast and has its own quota.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
# Model for interview questions + feedback (backend/test_llm.py).
GEMINI_LLM_MODEL=gemini-3.5-flash-lite

# Optional absolute SQLite file path; parent directory must already exist.
# DATABASE_PATH=/absolute/path/to/app.db

# Set true when serving the shared site over HTTPS. Keep false for localhost HTTP.
COOKIE_SECURE=false

# Exact public frontend origin when using a reverse proxy (no trailing slash).
# APP_ORIGIN=https://your-project.vercel.app
